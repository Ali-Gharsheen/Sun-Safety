<%#
  header.ejs - shared top of every page: <head>, site header and navigation.
  Pages include it with:  include('../partials/header', { title: '...' })
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="SunSafety shows the UV index, today's forecast and simple sun protection advice for any city.">
  <title><%= title ? title + ' · SunSafety' : 'SunSafety' %></title>
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label="SunSafety home">
        <img src="/images/favicon.svg" alt="" width="32" height="32">
        <span>Sun<strong>Safety</strong></span>
      </a>
      <nav aria-label="Main">
        <%# Highlight the link for the page we're on %>
        <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Check UV</a>
        <a href="/guide" class="<%= currentPath === '/guide' ? 'active' : '' %>">UV Guide</a>
      </nav>
    </div>
  </header>

  <main id="main">
